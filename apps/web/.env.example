# Base URL of the SuiteASD REST API (the web app talks to the backend only via HTTP).
# The default "/api/v1" is a path on the same origin: next.config.ts forwards it to API_ORIGIN.
NEXT_PUBLIC_API_URL=/api/v1
# Where the Java backend listens (read by next.config.ts when the app is built and started).
API_ORIGIN=http://localhost:8080
