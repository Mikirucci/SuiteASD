# Copy to .env (git-ignored). All values below are DEV defaults, never use them in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# SQLite path is relative to prisma/schema.prisma. Use a postgresql:// URL after switching the datasource provider.
DATABASE_URL="file:./dev.db"
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Run in-process cron automations (disable on secondary instances).
SCHEDULER_ENABLED=true
# Where uploaded documents (medical certificates...) are stored. Back it up and encrypt the disk in production.
STORAGE_DIR=storage
